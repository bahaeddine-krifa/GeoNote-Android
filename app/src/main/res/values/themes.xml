<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GeoNote" parent="Theme.Material3.Light.NoActionBar">
        <!-- Couleurs principales -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_variant</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Formes arrondies -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.GeoNote.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.GeoNote.Medium</item>
    </style>

    <!-- Coins arrondis personnalisés -->
    <style name="ShapeAppearance.GeoNote.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.GeoNote.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>